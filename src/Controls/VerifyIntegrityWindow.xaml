<Window x:Class="MDPlus.Controls.VerifyIntegrityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify File Integrity (SHA-256) - MDPlus"
        Height="540" Width="680"
        MinHeight="450" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid Background="#1e1e1e" Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" Padding="20,16,20,16" BorderBrush="#3f3f46" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="🛡️ Release Integrity &amp; SHA-256 Verification" FontSize="16" FontWeight="Bold" Foreground="#f0f6fc" Margin="0,0,0,4"/>
                <TextBlock Text="Verify your MDPlus binary or any downloaded release against cryptographic SHA-256 hashes (Notepad++ standard)."
                           FontSize="12" Foreground="#8b949e" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Main Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,16">
            <StackPanel>
                <!-- Target File Selector -->
                <TextBlock Text="Target File to Verify:" FontWeight="SemiBold" FontSize="13" Foreground="#c9d1d9" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Name="FilePathTextBox" Background="#2d2d30" Foreground="#e6edf3" BorderBrush="#3f3f46" 
                             Padding="8,6,8,6" FontSize="12" VerticalContentAlignment="Center" TextChanged="FilePathTextBox_TextChanged"/>
                    <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="12,6,12,6" Background="#3c3c3c" Foreground="#e6edf3"
                            BorderBrush="#555555" Cursor="Hand" Click="BrowseFile_Click"/>
                    <Button Grid.Column="2" Content="Current App" Margin="6,0,0,0" Padding="10,6,10,6" Background="#3c3c3c" Foreground="#e6edf3"
                            BorderBrush="#555555" ToolTip="Verify currently running MDPlus.exe" Cursor="Hand" Click="CurrentApp_Click"/>
                </Grid>

                <!-- Computed Hash -->
                <TextBlock Text="Computed SHA-256 Hash:" FontWeight="SemiBold" FontSize="13" Foreground="#c9d1d9" Margin="0,4,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Name="ComputedHashTextBox" IsReadOnly="True" Background="#161b22" Foreground="#58a6ff" 
                             FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" Padding="8,6,8,6" BorderBrush="#30363d"
                             VerticalContentAlignment="Center" Text="Select a file to compute hash..."/>
                    <Button Grid.Column="1" Name="CopyHashButton" Content="Copy Hash" Margin="8,0,0,0" Padding="12,6,12,6" 
                            Background="#3c3c3c" Foreground="#e6edf3" BorderBrush="#555555" Cursor="Hand" Click="CopyHash_Click"/>
                </Grid>

                <!-- Expected Hash -->
                <TextBlock Text="Expected SHA-256 Hash (from official release notes or SHA256SUMS.txt):" FontWeight="SemiBold" FontSize="13" Foreground="#c9d1d9" Margin="0,4,0,6"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Name="ExpectedHashTextBox" Background="#2d2d30" Foreground="#e6edf3" BorderBrush="#3f3f46" 
                             FontFamily="Cascadia Code, Consolas, monospace" FontSize="12" Padding="8,6,8,6" VerticalContentAlignment="Center"
                             TextChanged="ExpectedHashTextBox_TextChanged"/>
                    <Button Grid.Column="1" Content="Paste" Margin="8,0,0,0" Padding="12,6,12,6" Background="#3c3c3c" Foreground="#e6edf3"
                            BorderBrush="#555555" Cursor="Hand" Click="PasteExpected_Click"/>
                    <Button Grid.Column="2" Content="Load File..." Margin="6,0,0,0" Padding="10,6,10,6" Background="#3c3c3c" Foreground="#e6edf3"
                            BorderBrush="#555555" ToolTip="Load from .sha256 or SHA256SUMS.txt" Cursor="Hand" Click="LoadChecksumFile_Click"/>
                </Grid>

                <!-- Verification Status Banner -->
                <Border Name="StatusBanner" Background="#252526" BorderBrush="#3f3f46" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,4,0,10">
                    <StackPanel Name="StatusPanel">
                        <TextBlock Name="StatusTitleText" Text="⚪ AWAITING INPUT" FontSize="14" FontWeight="Bold" Foreground="#8b949e" Margin="0,0,0,4"/>
                        <TextBlock Name="StatusDetailText" Text="Choose a file and supply an expected SHA-256 checksum to verify authenticity."
                                   FontSize="12" Foreground="#c9d1d9" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#252526" Padding="16,12,16,12" BorderBrush="#3f3f46" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Close" Width="90" Height="28" Background="#3c3c3c" Foreground="#e6edf3"
                        BorderBrush="#555555" Cursor="Hand" Click="Close_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
