<Window x:Class="MDPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MDPlus.Controls"
        xmlns:models="clr-namespace:MDPlus.Models"
        mc:Ignorable="d"
        Title="MDPlus v1.08 - Markdown Viewer" 
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Height="760" Width="1160"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp"
        Closing="Window_Closing">

    <Grid Name="RootGrid" Background="#1e1e1e">
        <Grid.RowDefinitions>
            <!-- Row 0: Menu Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Tab Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Find Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Main Workspace (Sidebar + Viewer) -->
            <RowDefinition Height="*" />
            <!-- Row 4: Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Menu Bar -->
        <Menu Grid.Row="0" Name="MainMenu" Visibility="Collapsed" Background="{DynamicResource MenuBackgroundBrush}" Foreground="{DynamicResource MenuForegroundBrush}" Padding="4,2,4,2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_New Tab" InputGestureText="Ctrl+N" Click="NewTab_Click" />
                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveFile_Click" />
                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveAsFile_Click" />
                <MenuItem Header="Open _Containing Folder" Click="OpenFolder_Click" />
                <Separator />
                <MenuItem Header="_Reload" InputGestureText="F5" Click="Reload_Click" />
                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Click="CloseTab_Click" />
                <MenuItem Header="Close _All Tabs" Click="CloseAllTabs_Click" />
                <Separator />
                <MenuItem Header="Export as _HTML..." InputGestureText="Ctrl+Shift+E" Click="ExportHtml_Click" />
                <MenuItem Header="Copy as HTML" InputGestureText="Ctrl+Shift+H" Click="CopyHtml_Click" />
                <MenuItem Header="_Print..." InputGestureText="Ctrl+P" Click="Print_Click" />
                <Separator />
                <MenuItem Header="_Recent Files" Name="RecentFilesMenu" />
                <MenuItem Header="On _Startup" Name="StartupMenu">
                    <MenuItem Header="_Resume Previous Session" IsCheckable="True" Name="StartupResumeItem" Click="StartupResume_Click" />
                    <MenuItem Header="_Start Fresh" IsCheckable="True" Name="StartupFreshItem" Click="StartupFresh_Click" />
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click" />
                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                <Separator />
                <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="Find_Click" />
                <MenuItem Header="Find _Next" InputGestureText="F3" Click="FindNext_Click" />
                <MenuItem Header="Find _Previous" InputGestureText="Shift+F3" Click="FindPrevious_Click" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Click="ZoomIn_Click" />
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click" />
                <MenuItem Header="_Reset Zoom" InputGestureText="Ctrl+0" Click="ResetZoom_Click" />
                <Separator />
                <MenuItem Header="Toggle _Menu Bar" InputGestureText="Ctrl+M" IsCheckable="True" Name="ToggleMenuBarMenuItem" Click="ToggleMenuBar_Click" />
                <MenuItem Header="Table of _Contents" InputGestureText="Ctrl+T" IsCheckable="True" Name="TocMenuItem" Click="ToggleToc_Click" />
                <Separator />
                <MenuItem Header="View Mode">
                    <MenuItem Header="_Rendered Only" InputGestureText="Ctrl+1" Name="ViewRenderedItem" Click="ViewRendered_Click" />
                    <MenuItem Header="_Split View (Rendered + Raw)" InputGestureText="Ctrl+2" Name="ViewSplitItem" Click="ViewSplit_Click" />
                    <MenuItem Header="_Raw Markdown Only" InputGestureText="Ctrl+3" Name="ViewRawItem" Click="ViewRaw_Click" />
                </MenuItem>
                <MenuItem Header="_Word Wrap" IsCheckable="True" Name="WordWrapMenuItem" Click="ToggleWordWrap_Click" />
                <Separator />
                <MenuItem Header="_Theme" Name="ThemeMenu">
                    <MenuItem Header="_Dark Themes" Name="ThemeDarkThemesMenu">
                        <MenuItem Header="_GitHub Dark" Click="ThemePreset_Click" Tag="GitHubDark" IsCheckable="True" Name="ThemeGitHubDarkItem" />
                        <MenuItem Header="_Nord" Click="ThemePreset_Click" Tag="Nord" IsCheckable="True" Name="ThemeNordItem" />
                        <MenuItem Header="_One Dark" Click="ThemePreset_Click" Tag="OneDark" IsCheckable="True" Name="ThemeOneDarkItem" />
                        <MenuItem Header="_Monokai" Click="ThemePreset_Click" Tag="Monokai" IsCheckable="True" Name="ThemeMonokaiItem" />
                    </MenuItem>
                    <MenuItem Header="_Light Themes" Name="ThemeLightThemesMenu">
                        <MenuItem Header="_GitHub Light" Click="ThemePreset_Click" Tag="GitHubLight" IsCheckable="True" Name="ThemeGitHubLightItem" />
                        <MenuItem Header="_One Light" Click="ThemePreset_Click" Tag="OneLight" IsCheckable="True" Name="ThemeOneLightItem" />
                        <MenuItem Header="_Solarized Light" Click="ThemePreset_Click" Tag="SolarizedLight" IsCheckable="True" Name="ThemeSolarizedLightItem" />
                        <MenuItem Header="_Quiet Light" Click="ThemePreset_Click" Tag="QuietLight" IsCheckable="True" Name="ThemeQuietLightItem" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="_Cycle Next Theme" InputGestureText="F8" Click="CycleTheme_Click" />
                </MenuItem>
                <MenuItem Header="Full _Screen" InputGestureText="F11" Click="ToggleFullscreen_Click" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="Open Files in _New Tab" IsCheckable="True" Name="OpenFilesInNewTabMenuItem" Click="OpenFilesInNewTab_Click" />
                <Separator />
                <MenuItem Header="Verify File _Integrity (SHA-256)..." Click="ToolsVerifyIntegrity_Click" />
            </MenuItem>

            <MenuItem Header="_Plugins" Name="PluginsMenu">
                <MenuItem Header="Enable _LaTeX Math Rendering" IsCheckable="True" Name="PluginLatexMenuItem" Click="PluginLatex_Click" />
                <MenuItem Header="Enable _HTML Rendering" IsCheckable="True" Name="PluginHtmlMenuItem" Click="PluginHtml_Click" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Markdown _Reference" Click="HelpMarkdownRef_Click" />
                <MenuItem Header="_Keyboard Shortcuts" Click="HelpShortcuts_Click" />
                <Separator />
                <MenuItem Header="Check for _Updates..." Click="CheckForUpdates_Click" />
                <MenuItem Header="Verify _Release Integrity (SHA-256)..." Click="ToolsVerifyIntegrity_Click" />
                <Separator />
                <MenuItem Header="_About MDPlus" Click="HelpAbout_Click" />
            </MenuItem>
        </Menu>

        <!-- 2. Tab Bar -->
        <Border Grid.Row="1" Name="TabBarBorder" Background="#252526" BorderThickness="0,0,0,1" BorderBrush="#3f3f46">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Name="HamburgerMenuButton" Content="☰" Width="30" Height="26" Margin="4,2,2,2" 
                        Click="HamburgerMenu_Click" ToolTip="Menu (Alt or Ctrl+M)"
                        Background="Transparent" Foreground="{DynamicResource MutedForegroundBrush}" BorderThickness="0" 
                        FontSize="15" Cursor="Hand" Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="4,2,4,2" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="BtnContent" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource MenuHoverBackgroundBrush}"/>
                                    <Setter TargetName="BtnContent" Property="TextElement.Foreground" Value="{DynamicResource MenuHoverForegroundBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource MenuHoverBackgroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="HamburgerContextMenu" Placement="Bottom">
                            <MenuItem Header="_File">
                                <MenuItem Header="_New Tab" InputGestureText="Ctrl+N" Click="NewTab_Click" />
                                <MenuItem Header="_Open File..." InputGestureText="Ctrl+O" Click="OpenFile_Click" />
                                <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveFile_Click" />
                                <MenuItem Header="Save _As..." InputGestureText="Ctrl+Shift+S" Click="SaveAsFile_Click" />
                                <MenuItem Header="Open _Containing Folder" Click="OpenFolder_Click" />
                                <Separator />
                                <MenuItem Header="_Reload" InputGestureText="F5" Click="Reload_Click" />
                                <MenuItem Header="_Close Tab" InputGestureText="Ctrl+W" Click="CloseTab_Click" />
                                <MenuItem Header="Close _All Tabs" Click="CloseAllTabs_Click" />
                                <Separator />
                                <MenuItem Header="Export as _HTML..." InputGestureText="Ctrl+Shift+E" Click="ExportHtml_Click" />
                                <MenuItem Header="Copy as HTML" InputGestureText="Ctrl+Shift+H" Click="CopyHtml_Click" />
                                <MenuItem Header="_Print..." InputGestureText="Ctrl+P" Click="Print_Click" />
                                <Separator />
                                <MenuItem Header="_Recent Files" Name="HamburgerRecentFilesMenu" />
                                <MenuItem Header="On _Startup" Name="HamburgerStartupMenu">
                                    <MenuItem Header="_Resume Previous Session" IsCheckable="True" Name="HamburgerStartupResumeItem" Click="StartupResume_Click" />
                                    <MenuItem Header="_Start Fresh" IsCheckable="True" Name="HamburgerStartupFreshItem" Click="StartupFresh_Click" />
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
                            </MenuItem>

                            <MenuItem Header="_Edit">
                                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="Copy_Click" />
                                <MenuItem Header="Select _All" InputGestureText="Ctrl+A" Click="SelectAll_Click" />
                                <Separator />
                                <MenuItem Header="_Find..." InputGestureText="Ctrl+F" Click="Find_Click" />
                                <MenuItem Header="Find _Next" InputGestureText="F3" Click="FindNext_Click" />
                                <MenuItem Header="Find _Previous" InputGestureText="Shift+F3" Click="FindPrevious_Click" />
                            </MenuItem>

                            <MenuItem Header="_View">
                                <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Click="ZoomIn_Click" />
                                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Click="ZoomOut_Click" />
                                <MenuItem Header="_Reset Zoom" InputGestureText="Ctrl+0" Click="ResetZoom_Click" />
                                <Separator />
                                <MenuItem Header="Toggle _Menu Bar" InputGestureText="Ctrl+M" IsCheckable="True" Name="HamburgerViewToggleMenuBarItem" Click="ToggleMenuBar_Click" />
                                <MenuItem Header="Table of _Contents" InputGestureText="Ctrl+T" IsCheckable="True" Name="HamburgerTocMenuItem" Click="ToggleToc_Click" />
                                <Separator />
                                <MenuItem Header="View Mode">
                                    <MenuItem Header="_Rendered Only" InputGestureText="Ctrl+1" IsCheckable="True" IsChecked="True" Name="HamburgerViewRenderedItem" Click="ViewRendered_Click" />
                                    <MenuItem Header="_Split View (Rendered + Raw)" InputGestureText="Ctrl+2" IsCheckable="True" Name="HamburgerViewSplitItem" Click="ViewSplit_Click" />
                                    <MenuItem Header="_Raw Markdown Only" InputGestureText="Ctrl+3" IsCheckable="True" Name="HamburgerViewRawItem" Click="ViewRaw_Click" />
                                </MenuItem>
                                <MenuItem Header="_Word Wrap" IsCheckable="True" Name="HamburgerWordWrapMenuItem" Click="ToggleWordWrap_Click" />
                                <Separator />
                                <MenuItem Header="_Theme" Name="HamburgerThemeMenu">
                                    <MenuItem Header="_Dark Themes" Name="HamburgerThemeDarkThemesMenu">
                                        <MenuItem Header="_GitHub Dark" Click="ThemePreset_Click" Tag="GitHubDark" IsCheckable="True" Name="HamburgerThemeGitHubDarkItem" />
                                        <MenuItem Header="_Nord" Click="ThemePreset_Click" Tag="Nord" IsCheckable="True" Name="HamburgerThemeNordItem" />
                                        <MenuItem Header="_One Dark" Click="ThemePreset_Click" Tag="OneDark" IsCheckable="True" Name="HamburgerThemeOneDarkItem" />
                                        <MenuItem Header="_Monokai" Click="ThemePreset_Click" Tag="Monokai" IsCheckable="True" Name="HamburgerThemeMonokaiItem" />
                                    </MenuItem>
                                    <MenuItem Header="_Light Themes" Name="HamburgerThemeLightThemesMenu">
                                        <MenuItem Header="_GitHub Light" Click="ThemePreset_Click" Tag="GitHubLight" IsCheckable="True" Name="HamburgerThemeGitHubLightItem" />
                                        <MenuItem Header="_One Light" Click="ThemePreset_Click" Tag="OneLight" IsCheckable="True" Name="HamburgerThemeOneLightItem" />
                                        <MenuItem Header="_Solarized Light" Click="ThemePreset_Click" Tag="SolarizedLight" IsCheckable="True" Name="HamburgerThemeSolarizedLightItem" />
                                        <MenuItem Header="_Quiet Light" Click="ThemePreset_Click" Tag="QuietLight" IsCheckable="True" Name="HamburgerThemeQuietLightItem" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="_Cycle Next Theme" InputGestureText="F8" Click="CycleTheme_Click" />
                                </MenuItem>
                                <MenuItem Header="Full _Screen" InputGestureText="F11" Click="ToggleFullscreen_Click" />
                            </MenuItem>

                            <MenuItem Header="_Tools">
                                <MenuItem Header="Open Files in _New Tab" IsCheckable="True" Name="HamburgerOpenFilesInNewTabMenuItem" Click="OpenFilesInNewTab_Click" />
                                <Separator />
                                <MenuItem Header="Verify File _Integrity (SHA-256)..." Click="ToolsVerifyIntegrity_Click" />
                            </MenuItem>

                            <MenuItem Header="_Plugins" Name="HamburgerPluginsMenu">
                                <MenuItem Header="Enable _LaTeX Math Rendering" IsCheckable="True" Name="HamburgerPluginLatexMenuItem" Click="PluginLatex_Click" />
                                <MenuItem Header="Enable _HTML Rendering" IsCheckable="True" Name="HamburgerPluginHtmlMenuItem" Click="PluginHtml_Click" />
                            </MenuItem>

                            <MenuItem Header="_Help">
                                <MenuItem Header="Markdown _Reference" Click="HelpMarkdownRef_Click" />
                                <MenuItem Header="_Keyboard Shortcuts" Click="HelpShortcuts_Click" />
                                <Separator />
                                <MenuItem Header="Check for _Updates..." Click="CheckForUpdates_Click" />
                                <MenuItem Header="Verify _Release Integrity (SHA-256)..." Click="ToolsVerifyIntegrity_Click" />
                                <Separator />
                                <MenuItem Header="_About MDPlus" Click="HelpAbout_Click" />
                            </MenuItem>

                            <Separator />
                            <MenuItem Header="Toggle _Menu Bar" InputGestureText="Ctrl+M" IsCheckable="True" Name="HamburgerToggleMenuBarItem" Click="ToggleMenuBar_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Name="TabStripPanel" Orientation="Horizontal">
                        <!-- Dynamic Document Tabs added in code -->
                        <Button Name="NewTabButton" Content="+" Width="30" Height="28" Margin="4,2,4,2" 
                                Click="NewTab_Click" ToolTip="New Tab (Ctrl+N)"
                                Background="Transparent" Foreground="#888888" BorderThickness="0" 
                                FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 3. Find Bar (Docked) -->
        <controls:FindBar Grid.Row="2" x:Name="DocumentFindBar" Visibility="Collapsed" />

        <!-- 4. Main Workspace (TOC Sidebar + Content Area) -->
        <Grid Grid.Row="3" Name="WorkspaceGrid">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Table of Contents Sidebar -->
                <ColumnDefinition Width="260" MinWidth="140" MaxWidth="500" Name="SidebarColumn" />
                <!-- Column 1: Splitter -->
                <ColumnDefinition Width="5" Name="SidebarSplitterColumn" />
                <!-- Column 2: Document Content (Rendered / Raw / Split) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Table of Contents Sidebar -->
            <Border Grid.Column="0" Name="SidebarBorder" Background="{DynamicResource SidebarBackgroundBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource BorderBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Name="SidebarHeaderBorder" Background="{DynamicResource MenuBackgroundBrush}" Padding="12,0,8,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Name="SidebarHeaderTitle" Text="TABLE OF CONTENTS" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                            <Button Name="SidebarCloseButton" Content="✕" Width="20" Height="20" HorizontalAlignment="Right" 
                                    Click="CloseSidebar_Click" ToolTip="Hide Outline (Ctrl+T)"
                                    Background="Transparent" Foreground="{DynamicResource MutedForegroundBrush}" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" Name="TocListBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="TocListBox_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,4,6,4"/>
                                <Setter Property="Margin" Value="2,1,2,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                    BorderThickness="0" CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                <ContentPresenter SnapsToDevicePixels="True"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource MenuHoverBackgroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:HeadingItem}">
                                <TextBlock Text="{Binding Text}" Margin="{Binding IndentMargin}" ToolTip="{Binding Text}"
                                           TextTrimming="CharacterEllipsis" FontSize="13" Cursor="Hand">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="1">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource HeadingForegroundBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="2">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- GridSplitter between TOC and Document -->
            <GridSplitter Grid.Column="1" Name="SidebarSplitter" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Cursor="SizeWE" />

            <!-- Document Content Area (Split between Rendered and Raw views) -->
            <Grid Grid.Column="2" Name="ContentGrid" Background="#1e1e1e">
                <Grid.ColumnDefinitions>
                    <!-- Rendered Column -->
                    <ColumnDefinition Width="*" Name="RenderedColumn" />
                    <!-- Content Splitter -->
                    <ColumnDefinition Width="5" Name="ContentSplitterColumn" />
                    <!-- Raw Markdown Column -->
                    <ColumnDefinition Width="*" Name="RawColumn" />
                </Grid.ColumnDefinitions>

                <!-- Rendered FlowDocument Rich Editor -->
                <controls:MarkdownScrollViewer Grid.Column="0" x:Name="MarkdownViewer" 
                                                BorderThickness="0" Background="Transparent" Foreground="#cccccc"
                                                IsDocumentEnabled="True" AcceptsReturn="True" AcceptsTab="True"
                                                VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                PreviewMouseWheel="MarkdownViewer_PreviewMouseWheel"/>

                <!-- Content Splitter (only active in Split View) -->
                <GridSplitter Grid.Column="1" Name="ContentSplitter" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Cursor="SizeWE" Visibility="Collapsed" />

                <!-- Raw Markdown Text Box (for Raw or Split view) -->
                <TextBox Grid.Column="2" Name="RawMarkdownTextBox" Visibility="Collapsed"
                         FontFamily="Cascadia Code, Consolas, Courier New, monospace" FontSize="13"
                         Background="#1e1e1e" Foreground="#d4d4d4"
                         AcceptsReturn="True" AcceptsTab="True"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         IsReadOnly="False" TextWrapping="Wrap"
                         BorderThickness="0" Padding="16"/>

                <!-- Welcome Screen Placeholder (when no tabs open) -->
                <Border Name="WelcomeScreen" Background="#1e1e1e" Visibility="Collapsed" Grid.ColumnSpan="3">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
                        <TextBlock Text="MDPlus" FontSize="36" FontWeight="Bold" Foreground="#58a6ff" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Fast, lightweight native Windows Markdown viewer" FontSize="15" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                        
                        <Button Content="📂 Open Markdown File... (Ctrl+O)" Height="38" Padding="20,0,20,0" FontSize="14" 
                                Margin="0,0,0,8" Click="OpenFile_Click" Cursor="Hand"
                                Background="#0969da" Foreground="#ffffff" BorderThickness="0" FontWeight="SemiBold"/>
                        
                        <Button Content="➕ New Document (Ctrl+N)" Height="34" Padding="20,0,20,0" FontSize="13" 
                                Margin="0,0,0,12" Click="NewTab_Click" Cursor="Hand"
                                Background="#21262d" Foreground="#ffffff" BorderThickness="1" BorderBrush="#30363d" FontWeight="SemiBold"/>
                        
                        <TextBlock Text="Or drag and drop any .md file here" FontSize="13" Foreground="#666666" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 5. Status Bar -->
        <StatusBar Grid.Row="4" Name="AppStatusBar" Background="#007acc" Foreground="#ffffff" Height="26" Padding="8,0,8,0">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Name="StatusFileText" Text="Ready" FontSize="12" Foreground="{Binding Path=Foreground, ElementName=AppStatusBar}"/>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="StatusStatsText" Text="0 words • 0 chars" FontSize="12" Margin="0,0,16,0" Foreground="{Binding Path=Foreground, ElementName=AppStatusBar}"/>
                    <TextBlock Name="StatusZoomText" Text="100%" FontSize="12" Margin="0,0,16,0" Cursor="Hand" ToolTip="Click to reset zoom" MouseLeftButtonUp="StatusZoom_Click" Foreground="{Binding Path=Foreground, ElementName=AppStatusBar}"/>
                    <TextBlock Name="StatusEncodingText" Text="UTF-8" FontSize="12" Margin="0,0,16,0" Foreground="{Binding Path=Foreground, ElementName=AppStatusBar}"/>
                    <TextBlock Name="StatusViewModeText" Text="Rendered" FontSize="12" Margin="0,0,8,0" Cursor="Hand" ToolTip="Click to switch view mode" MouseLeftButtonUp="StatusViewMode_Click" Foreground="{Binding Path=Foreground, ElementName=AppStatusBar}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
