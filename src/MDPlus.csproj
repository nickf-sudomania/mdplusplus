<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>MDPlus</RootNamespace>
    <AssemblyName>MDPlus</AssemblyName>
    <Version>1.0.0</Version>
    <ApplicationIcon Condition="Exists('Resources\AppIcon.ico')">Resources\AppIcon.ico</ApplicationIcon>
    <Authors>MDPlus</Authors>
    <Product>MDPlus Markdown Viewer</Product>
    <Description>Fast, lightweight native Windows Markdown viewer inspired by Notepad and Notepad++</Description>
    <StartupObject>MDPlus.App</StartupObject>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Include sample documents in output folder for testing and out-of-the-box experience -->
  <ItemGroup>
    <None Include="..\sample_docs\**\*" Link="sample_docs\%(RecursiveDir)%(FileName)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
